{
  "name": "subtitle-studio",
  "version": "1.0.0",
  "description": "AI 视频字幕生成工具 - 基于 Whisper 本地运行",
  "main": "electron/main.js",
  "author": "Subtitle Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "bash scripts/electron_dev.sh",
    "build:win": "cd frontend && npm run build && cd .. && electron-builder --win --x64",
    "build:mac": "cd frontend && npm run build && cd .. && electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "bash scripts/build_backend.sh",
    "build": "npm run build:frontend && npm run build:backend && electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.subtitle-studio.app",
    "productName": "Subtitle Studio",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/",
        "to": "backend/",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "Subtitle Studio",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
